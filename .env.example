# Copy to .env and fill in. Never commit .env.

# Where contact-form messages are delivered (your inbox).
CONTACT_TO=arthemyo.rodriguez@gmail.com

# SMTP account used to send them. For Gmail: turn on 2-Step Verification,
# then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=arthemyo.rodriguez@gmail.com
SMTP_PASS=
# Sender shown in the email (defaults to SMTP_USER).
MAIL_FROM="Portfolio <arthemyo.rodriguez@gmail.com>"

# Server
PORT=3000
HOST=127.0.0.1
# NODE_ENV=production
# Comma-separated origins allowed to POST the form (your site's URL in production).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Number of reverse proxies in front of the app (leave empty when running directly).
TRUST_PROXY=

# Rate limit per IP: RATE_LIMIT_MAX messages every RATE_LIMIT_WINDOW_MIN minutes.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15
